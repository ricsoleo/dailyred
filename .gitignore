# Everything below is recreated by the scripts in scripts/ (see README).

# scripts/setup-macos.sh
/.toolchain/
# scripts/get-pokefirered.sh (pret/pokefirered + patches/)
/pokefirered/
# scripts/fetch-vendor.sh
/web/vendor/
# scripts/build-rom.sh. Build output; don't commit it.
/web/game/

# Wrangler's local cache (Cloudflare deploys)
/.wrangler/

/tests/node_modules/
/tests/output/
.DS_Store

# server/: wrangler local state and dependencies
/server/.wrangler/
/server/node_modules/
# scripts/build-patches.sh: unmodified pret/pokefirered and its original ROMs
/.retail/

# server/: local secrets for the dev server (ADMIN_TOKEN=...)
/server/.dev.vars
# the production admin token, kept only on this computer
/.admin-token
